# SuitCVLO-open — variables opcionales (copia a .env y rellena lo que uses)
# El switch funciona sin ninguna: va bajando por la cadena hasta que una responda.

# 1) Ollama local — primer eslabón, sin costo, offline
OLLAMA_URL=http://127.0.0.1:11434
CVLO_VLM=qwen3.5:latest
# Segundos máximos por foto en CPU (medido: ~392 s con qwen3.5 + imagen 1600px)
OLLAMA_TIMEOUT_S=900

# 2) DeepSeek — nube, 5M tokens GRATIS al registrar (sin tarjeta, caducan a los 30 días)
#    Alta: https://platform.deepseek.com → Sign Up → API Keys → Generate
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash

# 3) OpenRouter — nube, modelos gratis con visión
OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash:free

# 4) Gemini — nube, mejor OCR en español
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Servidor
CVLO_PUERTO=3015
# CVLO_MOCK=1
