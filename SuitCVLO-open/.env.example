# SuitCVLO-open — variables opcionales (copia a .env y rellena lo que uses)
# El switch funciona sin ninguna: va bajando por la cadena hasta que una responda.
# PRIORIDAD: este .env manda sobre las variables del sistema. Valor vacío = eslabón desactivado.

# 0) OpenCode — PRIMER ESLABÓN. La key se lee sola de ~/.local/share/opencode/auth.json
#    (la que guarda `opencode auth login`); solo rellénala si quieres fijarla a mano.
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1      # Go (suscripción) | Zen: https://opencode.ai/zen/v1
OPENCODE_VISION_MODEL=deepseek-v4-flash-vision-exp

# 1) Ollama local — sin costo, offline
OLLAMA_URL=http://127.0.0.1:11434
CVLO_VLM=qwen3.5:latest
# Segundos máximos por foto en CPU (medido: ~392 s con qwen3.5 + imagen 1600px)
OLLAMA_TIMEOUT_S=900

# 1.5) HuggingFace — router gratis con visión. La variable del sistema HF_TOKEN ya sirve;
#      si prefieres fijarla aquí, pégala SIN la línea en blanco y sin comillas:
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx
# HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# 2) DeepSeek — nube, 5M tokens GRATIS al registrar (sin tarjeta, caducan a los 30 días)
#    Alta: https://platform.deepseek.com → Sign Up → API Keys → Generate
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash

# 3) OpenRouter — nube, modelos gratis con visión
OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash:free

# 4) Gemini — nube, mejor OCR en español
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Servidor
CVLO_PUERTO=3015
# CVLO_MOCK=1
