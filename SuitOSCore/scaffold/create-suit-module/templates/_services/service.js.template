// Example service — replace with your own business logic

const DB = [];

async function list() {
  return DB;
}

async function getById(id) {
  return DB.find(item => item.id === id) || null;
}

async function create(data) {
  const item = { id: String(Date.now()), ...data, activo: true, createdAt: new Date().toISOString() };
  DB.push(item);
  return item;
}

async function update(id, data) {
  const idx = DB.findIndex(item => item.id === id);
  if (idx === -1) throw new Error('Not found');
  DB[idx] = { ...DB[idx], ...data, updatedAt: new Date().toISOString() };
  return DB[idx];
}

async function softDelete(id) {
  const item = DB.find(item => item.id === id);
  if (!item) throw new Error('Not found');
  item.activo = false;
  item.deletedAt = new Date().toISOString();
}

module.exports = { list, getById, create, update, softDelete };
