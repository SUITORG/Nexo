PORT=3017
# PYTHON=python
# PIN del taller para /app (Fase 5). Vacío = sin login (solo dev). En Fase 7 el signup genera taller.json y este se ignora.
APP_PIN=
# Fase 7 — cobro: link de Stripe Payment Links (https://buy.stripe.com/...). Vacío = sin botón de pago.
STRIPE_LINK_URL=
# Fase 7 — contacto WhatsApp para la landing (formato: 528112345678)
CONTACTO_WA=
# Fase 6 — alertas por correo (smtp.gmail.com + App Password de Google).
# Sin SMTP_HOST → alerta solo imprime en consola (no envía correo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTA_EMAIL=
# Frecuencia de alertas+respaldo en horas (default 24)
HORAS_ALERTA=24
# Leads de la landing (opcional sin .env): supabase.co → leads_contractrenew
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
