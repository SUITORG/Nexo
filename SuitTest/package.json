{
  "name": "suittest",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto de prueba SuitOS Core — CRUD de contactos con multi-tenant",
  "scripts": {
    "start": "node backend/server.js",
    "registry:build": "cd ../SuitOSCore && node tooling/build-registry.js --mcp",
    "registry:verify": "cd ../SuitOSCore && node tooling/build-registry.js --verify",
    "registry:server": "cd ../SuitOSCore && node tooling/build-registry.js --server --watch --mcp",
    "check": "node --check backend/server.js && node --check src/app.js",
    "test": "node ../SuitOSCore/scripts/agents/probador.js --suite health",
    "smoke": "node ../SuitOSCore/scripts/agents/probador.js --suite health"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
