{
  "mcpServers": {
    "supabase": {
      "command": "node",
      "args": ["scripts/mcp-supabase.js"]
    },
    "whatsapp": {
      "command": "npx",
      "args": ["wappmcp", "mcp"],
      "env": {
        "WAPPMCP_DATA_DIR": "~/.wappmcp"
      }
    },
    "higgsfield": {
      "url": "https://mcp.higgsfield.ai/mcp"
    }
  }
}
